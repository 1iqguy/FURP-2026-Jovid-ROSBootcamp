bt_navigator:
   ros__parameters:
      use_sim_time: true
      global_frame: map
      robot_base_frame: base_link
      odom_topic: /odom
      transform_tolerance: 0.2
      bt_loop_duration: 20
      default_server_timeout: 20
      #default_nav_to_pose_bt_xml: "$(find-pkg-share nav2_bt_navigator)/behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml"

behavior_server:
   ros__parameters:
      use_sim_time: true
      global_frame: odom
      robot_base_frame: base_link
      costmap_topic: local_costmap/costmap_raw
      footprint_topic: local_costmap/published_footprint
      cycle_frequency: 10.0
      simulate_ahead_time: 2.0
      behavior_plugins: ["backup", "spin", "wait", "drive_on_heading"]
      backup:
         plugin: "nav2_behaviors/BackUp"
      spin:
         plugin: "nav2_behaviors/Spin"
      wait:
         plugin: "nav2_behaviors/Wait"
      drive_on_heading:
         plugin: "nav2_behaviors/DriveOnHeading"
      max_rotational_vel: 1.6
      min_rotational_vel: 0.4
      rotational_acc_lim: 3.5
      transform_tolerance: 0.2

planner_server:
   ros__parameters:
      use_sim_time: true
      expected_planner_frequency: 1.0  
      planner_plugins: ["GridBased"]
      GridBased:
         plugin: "nav2_navfn_planner/NavfnPlanner"
         tolerance: 0.75 
         use_astar: false #// false- Djikstra, true- A*
         allow_unknown: true #//false - unknown pixels are occupied (true for frontier exploration)

controller_server:
   ros__parameters:
      use_sim_time: true
      controller_frequency: 20.0
      min_x_velocity_threshold: 0.001
      min_y_velocity_threshold: 0.5
      min_theta_velocity_threshold: 0.001
      failure_tolerance: 0.3
      odom_topic: /odom
      progress_checker_plugin: "progress_checker"
      progress_checker:
         plugin: "nav2_controller::SimpleProgressChecker"
         required_movement_radius: 0.5
         movement_time_allowance: 15.0
      goal_checker_plugins: ["goal_checker"]
      goal_checker:
         plugin: "nav2_controller::SimpleGoalChecker"
         xy_goal_tolerance: 0.15
         yaw_goal_tolerance: 3.15   
         stateful: true
      controller_plugins: ["FollowPath"]
      FollowPath:
         plugin: "nav2_mppi_controller::MPPIController"
         time_steps: 36
         model_dt: 0.05
         batch_size: 2000
         iteration_count: 1
         prune_distance: 1.4
         transform_tolerance: 0.1
         temperature: 0.2
         gamma: 0.015
         motion_model: "DiffDrive"
         visualize: false #// true- publishes candidate trajectories for RViz (expensive)
         regenerate_noises: true #// true- fresh noise every iteration, better exploration, slower
         vx_max: 0.75
         vx_min: -0.45
         vy_max: 0.0
         wz_max: 1.6
         ax_max: 1.8
         ax_min: -1.2
         az_max: 2.5
         vx_std: 0.25
         vy_std: 0.0
         wz_std: 0.5
         AckermannConstraints:
            min_turning_r: 0.2 #// unused with DiffDrive, harmless
         critics: ["ConstraintCritic", "CostCritic", "GoalCritic", "PathAlignCritic", "PathFollowCritic", "PathAngleCritic", "PreferForwardCritic"]
         ConstraintCritic:
            enabled: true
            cost_power: 1
            cost_weight: 6.0
         CostCritic:
            enabled: true
            cost_power: 1
            cost_weight: 3.81
            critical_cost: 300.0
            consider_footprint: true
            collision_cost: 1000000.0
            near_goal_distance: 1.0
            trajectory_point_step: 2
